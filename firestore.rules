// Mustang Splits rules 2.7.0
rules_version = '2';

// Mustang Splits security rules (Firebase project: mustang-splits).
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
// Design notes live in CLAUDE.md ("Team sync" and "Team admin"). Summary:
//   teamKeys/{hash}              team password hash -> {teamId, pwVersion}. Get by id only; never listable.
//   adminKeys/{hash}             admin passphrase hash -> {teamId, adminVersion}. Members only, by id; never listable.
//   teams/{teamId}               {name, pwVersion, hasAdmin, adminVersion, createdAt}. Members only.
//   teams/{teamId}/members/{uid} {pwVersion, key, adminVersion?, adminKey?}. A device may only see its own.
//   teams/{teamId}/athletes|workouts|history/{id}   team data. Members only.
//   teams/{teamId}/races/{raceId}(/marks/{markId})   Race Mode: race setup + one doc per tap. Members only.
//   teams/{teamId}/races/{raceId}/coaches/{uid}      Race Mode 2.4: each coach's checkpoint, name and app version.
// Data safety (2.6): no client can delete team data. Removals are soft (deleted: true, content kept), corrections
// are append-only (mark versions in hist, history edits), and a discarded race keeps everything and can be restored.
// The one exception: an admin's "Delete permanently" for one runner (privacy), tied to teams/{t}/purges/{athleteId}.
//   teams/{teamId}/devices/{uid}  each coach phone's app version and last-seen time (2.6).
//   teams/{teamId}/courses/{id}   saved courses (2.5): name + checkpoints. Members only.
//   teams/{teamId}/prs/{athleteId} PRs per runner (2.5): {list:[{dist, t}]}. Members only.
//   teams/{teamId}/series/{id}    meet series (2.7): {name}, links a meet across years. Members only, soft delete.
//   teams/{teamId}/meets/{id}     the schedule (2.7): {seriesId, courseId, date, time, kind, levels, season}.
//   clock/{uid}                  a device's own server timestamp, for measuring its clock offset.
// A device is a member while its membership pwVersion equals the team's pwVersion.
// A member is admin while the team hasAdmin and its membership adminVersion equals the team's adminVersion.
// Changing the password bumps pwVersion (locks out every other device until it rejoins);
// changing the admin passphrase bumps adminVersion (other admin devices become plain members).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
    function keyPath(k) { return /databases/$(database)/documents/teamKeys/$(k); }
    function adminKeyPath(k) { return /databases/$(database)/documents/adminKeys/$(k); }

    // Teams created before 2.1 have no admin fields: treat them as "no admin yet".
    function hasAdmin(d) { return d.get('hasAdmin', false) == true; }
    function adminVer(d) { return d.get('adminVersion', 0); }

    // Joined with the current team password.
    function isMember(t) {
      return signedIn()
        && exists(memberPath(t))
        && get(memberPath(t)).data.pwVersion == get(teamPath(t)).data.pwVersion;
    }
    // A member whose admin proof matches the team's current admin version.
    function isAdmin(t) {
      return isMember(t)
        && hasAdmin(get(teamPath(t)).data)
        && get(memberPath(t)).data.get('adminVersion', 0) == adminVer(get(teamPath(t)).data);
    }

    function shortString(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function racePath(t, r) { return /databases/$(database)/documents/teams/$(t)/races/$(r); }
    function purgePath(t, a) { return /databases/$(database)/documents/teams/$(t)/purges/$(a); }

    // ---------- data safety (2.6) ----------
    // A normal write: not deleted, and a restore recorded in it names the caller (or is unchanged).
    function notDeleted() {
      return request.resource.data.get('deleted', false) == false
        && (request.resource.data.get('restoredBy', '') == '' || request.resource.data.get('restoredBy', '') == request.auth.uid
          || (resource != null && request.resource.data.get('restoredBy', '') == resource.data.get('restoredBy', '')));
    }
    // A soft delete: only the deletion fields change, so the content stays exactly as it was.
    function softDeleting() {
      return request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time;
    }
    // Restoring by clearing the flag (Recently deleted > Show older). Restoring by writing the item again is a normal write.
    function restoringFlags() {
      return resource.data.get('deleted', false) == true && request.resource.data.get('deleted', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'restoredAt', 'restoredBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.restoredBy == request.auth.uid
        && request.resource.data.restoredAt == request.time;
    }
    function histSoftDelete() {
      return request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
        && request.resource.data.deletedBy == request.auth.uid && request.resource.data.deletedAt == request.time;
    }
    function histRestore() {
      return resource.data.get('deleted', false) == true && request.resource.data.get('deleted', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'restoredAt', 'restoredBy'])
        && request.resource.data.restoredBy == request.auth.uid && request.resource.data.restoredAt == request.time;
    }
    // An append-only list: grows, earlier entries unchanged, the newest entry made by the caller.
    function appended(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && request.resource.data[f] is list
        && request.resource.data[f].size() > resource.data.get(f, []).size()
        && request.resource.data[f].size() <= 3000
        && (resource.data.get(f, []).size() == 0 || request.resource.data[f][0:resource.data.get(f, []).size()] == resource.data.get(f, []))
        && request.resource.data[f][request.resource.data[f].size() - 1].uid == request.auth.uid;
    }
    // Admin purge: rewrites allowed only together with the purge record for that runner.
    function purging(t) {
      return request.resource.data.get('purgedFor', null) is string
        && existsAfter(purgePath(t, request.resource.data.purgedFor));
    }
    function athleteOk() {
      return request.resource.data.keys().hasOnly(['name', 'group', 'gender', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'])
        && shortString(request.resource.data.name, 1, 30)
        && shortString(request.resource.data.group, 0, 30)
        && request.resource.data.get('gender', 'G') in ['G', 'B']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function workoutOk() {
      return request.resource.data.keys().hasOnly(['name', 'reps', 'rest', 'restUnit', 'segments', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'])
        && shortString(request.resource.data.name, 0, 80)
        && request.resource.data.segments is list
        && request.resource.data.segments.size() <= 30
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function courseOk() {
      return request.resource.data.keys().hasOnly(['name', 'checkpoints', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'])
        && shortString(request.resource.data.name, 1, 40)
        && request.resource.data.checkpoints is list
        && request.resource.data.checkpoints.size() <= 12
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function seriesOk() {
      return request.resource.data.keys().hasOnly(['name', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'])
        && shortString(request.resource.data.name, 1, 40)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function meetOk() {
      return request.resource.data.keys().hasOnly(['seriesId', 'courseId', 'date', 'time', 'kind', 'levels', 'season', 'updatedAt', 'updatedBy', 'deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'])
        && shortString(request.resource.data.seriesId, 1, 60)
        && shortString(request.resource.data.courseId, 0, 60)
        && (request.resource.data.date == '' || (request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && shortString(request.resource.data.time, 0, 12)
        && shortString(request.resource.data.kind, 0, 30)
        && request.resource.data.levels is list && request.resource.data.levels.size() >= 1 && request.resource.data.levels.size() <= 2
        && request.resource.data.levels.hasOnly(['V', 'JV'])
        && request.resource.data.season is int && request.resource.data.season >= 2000 && request.resource.data.season <= 2100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function raceOk() {
      return request.resource.data.keys().hasOnly(['name', 'status', 'gun', 'checkpoints', 'runners', 'courseId', 'goalSrc', 'meetId', 'division',
          'discardedFrom', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy', 'updatedAt', 'updatedBy'])
        && shortString(request.resource.data.name, 0, 60)
        && (!('courseId' in request.resource.data) || request.resource.data.courseId == null || shortString(request.resource.data.courseId, 1, 40))
        && (!('goalSrc' in request.resource.data) || shortString(request.resource.data.goalSrc, 0, 10))
        && (request.resource.data.get('meetId', null) == null || shortString(request.resource.data.meetId, 1, 60))
        && request.resource.data.get('division', '') in ['', 'GV', 'BV', 'GJV', 'BJV', 'OPEN']
        && request.resource.data.status in ['setup', 'running', 'done', 'discarded']
        && (request.resource.data.gun == null || request.resource.data.gun is map)
        && request.resource.data.checkpoints is list && request.resource.data.checkpoints.size() <= 12
        && request.resource.data.runners is list && request.resource.data.runners.size() <= 150
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function markOk() {
      return request.resource.data.keys().hasOnly(['cp', 'local', 'off', 'runnerId', 'by', 'byName', 'deleted', 'chosen', 'hist', 'purgedFor', 'updatedAt', 'updatedBy'])
        && (!('byName' in request.resource.data) || request.resource.data.byName == null || shortString(request.resource.data.byName, 0, 30))
        && request.resource.data.cp is string
        && request.resource.data.local is number
        && (request.resource.data.off == null || request.resource.data.off is number)
        && (request.resource.data.runnerId == null || request.resource.data.runnerId is string)
        && request.resource.data.by is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    // Mark versions: the history only grows and keeps every earlier version exactly.
    function appendedHist() {
      return request.resource.data.hist is list
        && request.resource.data.hist.size() >= resource.data.get('hist', []).size()
        && request.resource.data.hist.size() <= 200
        && (resource.data.get('hist', []).size() == 0 || request.resource.data.hist[0:resource.data.get('hist', []).size()] == resource.data.get('hist', []));
    }
    function oldHist() { return resource == null ? [] : resource.data.get('hist', []); }
    // The top-level fields are the newest version, and a new newest version is the caller's.
    function versionOk() {
      return request.resource.data.hist is list && request.resource.data.hist.size() >= 1
        && request.resource.data.hist[request.resource.data.hist.size() - 1].cp == request.resource.data.cp
        && request.resource.data.hist[request.resource.data.hist.size() - 1].runnerId == request.resource.data.runnerId
        && request.resource.data.hist[request.resource.data.hist.size() - 1].local == request.resource.data.local
        && request.resource.data.hist[request.resource.data.hist.size() - 1].deleted == request.resource.data.get('deleted', false)
        && request.resource.data.hist[request.resource.data.hist.size() - 1].chosen == request.resource.data.get('chosen', false)
        && (request.resource.data.hist.size() == oldHist().size()
          || request.resource.data.hist[request.resource.data.hist.size() - 1].uid == request.auth.uid);
    }
    // Marks and presence can be written while the race exists (or is about to) and wasn't discarded.
    function raceOpen(t, r) { return !exists(racePath(t, r)) || get(racePath(t, r)).data.status != 'discarded'; }

    // ---------- clock offset (Race Mode) ----------
    // A device writes serverTimestamp() to its own doc and reads it back. Nothing else is stored.
    match /clock/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- team password keys ----------
    match /teamKeys/{key} {
      // Fetching a key requires already knowing the hash (the document id), i.e. the password.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && key.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['teamId', 'pwVersion'])
        && request.resource.data.teamId is string
        && (
          // A brand-new team created in the same batch.
          (!exists(teamPath(request.resource.data.teamId))
            && request.resource.data.pwVersion == 1
            && getAfter(teamPath(request.resource.data.teamId)).data.pwVersion == 1)
          ||
          // A password change by an admin: the version goes up by exactly one, in the same batch.
          (isAdmin(request.resource.data.teamId)
            && request.resource.data.pwVersion == get(teamPath(request.resource.data.teamId)).data.pwVersion + 1
            && getAfter(teamPath(request.resource.data.teamId)).data.pwVersion == request.resource.data.pwVersion)
        );
      allow update: if false;
      // Removing an old key (during a password change) needs its id and admin.
      allow delete: if isAdmin(resource.data.teamId);
    }

    // ---------- admin passphrase keys ----------
    match /adminKeys/{key} {
      // Only members can even ask, and only by the exact hash (knowing the passphrase).
      allow get: if isMember(resource.data.teamId);
      allow list: if false;
      allow create: if signedIn()
        && key.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['teamId', 'adminVersion'])
        && request.resource.data.teamId is string
        && (
          // A brand-new team created in the same batch, with its first admin.
          (!exists(teamPath(request.resource.data.teamId))
            && request.resource.data.adminVersion == 1
            && adminVer(getAfter(teamPath(request.resource.data.teamId)).data) == 1)
          ||
          // The first admin of an existing team (the team has no admin right now).
          (isMember(request.resource.data.teamId)
            && !hasAdmin(get(teamPath(request.resource.data.teamId)).data)
            && request.resource.data.adminVersion == adminVer(get(teamPath(request.resource.data.teamId)).data) + 1
            && adminVer(getAfter(teamPath(request.resource.data.teamId)).data) == request.resource.data.adminVersion)
          ||
          // An admin changing the admin passphrase.
          (isAdmin(request.resource.data.teamId)
            && request.resource.data.adminVersion == adminVer(get(teamPath(request.resource.data.teamId)).data) + 1
            && adminVer(getAfter(teamPath(request.resource.data.teamId)).data) == request.resource.data.adminVersion)
        );
      allow update: if false;
      allow delete: if isAdmin(resource.data.teamId);
    }

    // ---------- teams ----------
    match /teams/{teamId} {
      allow get: if isMember(teamId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'pwVersion', 'hasAdmin', 'adminVersion', 'createdAt'])
        && shortString(request.resource.data.name, 1, 40)
        && request.resource.data.pwVersion == 1
        && request.resource.data.hasAdmin == true
        && request.resource.data.adminVersion == 1
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(teamId)).data.pwVersion == 1
        && getAfter(memberPath(teamId)).data.adminVersion == 1;
      allow update: if isMember(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'pwVersion', 'hasAdmin', 'adminVersion'])
        && shortString(request.resource.data.name, 1, 40)
        && (
          // Admin: rename, change the password (+1) and/or change the admin passphrase (+1).
          // An admin can never switch hasAdmin off (only the project owner can, in the console).
          (isAdmin(teamId)
            && hasAdmin(request.resource.data)
            && (request.resource.data.pwVersion == resource.data.pwVersion
              || (request.resource.data.pwVersion == resource.data.pwVersion + 1
                && getAfter(memberPath(teamId)).data.pwVersion == request.resource.data.pwVersion))
            && (adminVer(request.resource.data) == adminVer(resource.data)
              || (adminVer(request.resource.data) == adminVer(resource.data) + 1
                && getAfter(memberPath(teamId)).data.get('adminVersion', 0) == adminVer(request.resource.data))))
          ||
          // Any member, only while the team has no admin: become the first admin. Nothing else changes.
          (!hasAdmin(resource.data)
            && request.resource.data.hasAdmin == true
            && adminVer(request.resource.data) == adminVer(resource.data) + 1
            && request.resource.data.name == resource.data.name
            && request.resource.data.pwVersion == resource.data.pwVersion
            && getAfter(memberPath(teamId)).data.get('adminVersion', 0) == adminVer(request.resource.data))
        );
      allow delete: if false;

      // ---------- memberships ----------
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        // Joining proves the password: the key document named by `key` must point at this team
        // at the team's current version. Admin fields prove the admin passphrase the same way.
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pwVersion', 'key', 'adminVersion', 'adminKey'])
          && request.resource.data.key is string
          && getAfter(keyPath(request.resource.data.key)).data.teamId == teamId
          && getAfter(keyPath(request.resource.data.key)).data.pwVersion == request.resource.data.pwVersion
          && getAfter(teamPath(teamId)).data.pwVersion == request.resource.data.pwVersion
          && (
            // Not admin.
            (!('adminKey' in request.resource.data) && request.resource.data.get('adminVersion', 0) == 0)
            ||
            // Admin: the named admin key belongs to this team at the team's current admin version.
            (request.resource.data.adminKey is string
              && getAfter(adminKeyPath(request.resource.data.adminKey)).data.teamId == teamId
              && getAfter(adminKeyPath(request.resource.data.adminKey)).data.adminVersion == request.resource.data.adminVersion
              && hasAdmin(getAfter(teamPath(teamId)).data)
              && adminVer(getAfter(teamPath(teamId)).data) == request.resource.data.adminVersion)
          );
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // ---------- shared team data (open to every member) ----------
      // Data safety (2.6): nothing here can be deleted by a client. A removal is an update that only sets
      // deleted/deletedAt/deletedBy (content unchanged); a restore clears it or writes the item again. The only
      // hard deletes are an admin's "Delete permanently" for one runner, which needs a purges/{athleteId} record.
      match /athletes/{athleteId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && athleteOk() && notDeleted();
        allow update: if isMember(teamId) && (softDeleting() || restoringFlags() || (athleteOk() && notDeleted()));
        allow delete: if isAdmin(teamId) && existsAfter(purgePath(teamId, athleteId));
      }

      match /workouts/{workoutId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && workoutOk() && notDeleted();
        allow update: if isMember(teamId) && (softDeleting() || restoringFlags() || (workoutOk() && notDeleted()));
        allow delete: if false;
      }

      // Saved courses (2.5)
      match /courses/{courseId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && courseOk() && notDeleted();
        allow update: if isMember(teamId) && (softDeleting() || restoringFlags() || (courseOk() && notDeleted()));
        allow delete: if false;
      }

      // Meet series and the meet schedule (2.7): shared like courses, soft delete only.
      match /series/{seriesId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && seriesOk() && notDeleted();
        allow update: if isMember(teamId) && (softDeleting() || restoringFlags() || (seriesOk() && notDeleted()));
        allow delete: if false;
      }

      match /meets/{meetId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && meetOk() && notDeleted();
        allow update: if isMember(teamId) && (softDeleting() || restoringFlags() || (meetOk() && notDeleted()));
        allow delete: if false;
      }

      // PRs (2.5). A removed PR stays in the list marked deleted, so the document is never removed.
      match /prs/{athleteId} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['list', 'updatedAt', 'updatedBy'])
          && request.resource.data.list is list
          && request.resource.data.list.size() >= 1
          && request.resource.data.list.size() <= 60
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isAdmin(teamId) && existsAfter(purgePath(teamId, athleteId));
      }

      // Saved results. Corrections are appended to `edits` (never rewritten); removal is a soft delete.
      match /history/{sessionId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['date', 'savedAtMs', 'savedBy', 'watches', 'kind', 'race', 'edits'])
          && shortString(request.resource.data.date, 10, 10)
          && request.resource.data.savedAtMs is number
          && request.resource.data.savedBy == request.auth.uid
          && request.resource.data.watches is list
          && request.resource.data.watches.size() <= 30
          && (!('kind' in request.resource.data) || request.resource.data.kind == 'race')
          && (!('race' in request.resource.data) || (request.resource.data.race is map && request.resource.data.kind == 'race'))
          && (!('edits' in request.resource.data) || request.resource.data.edits is list);
        allow update: if (isMember(teamId) && (histSoftDelete() || histRestore() || appended('edits')))
          || (isAdmin(teamId) && purging(teamId));
        allow delete: if false;
      }

      // ---------- Race Mode ----------
      // A race is never deleted. Discard keeps everything and only sets status 'discarded' (with discardedFrom,
      // deletedAt, deletedBy); only a restore (restoredBy = caller, restoredAt = now) can bring it back, so a phone
      // that was offline can't revive it by sending the old race again.
      match /races/{raceId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && raceOk()
          && (request.resource.data.status != 'discarded' || request.resource.data.get('deletedBy', '') == request.auth.uid);
        allow update: if isMember(teamId) && raceOk() && (
          (resource.data.status != 'discarded' && request.resource.data.status != 'discarded')
          || (resource.data.status != 'discarded' && request.resource.data.status == 'discarded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'discardedFrom', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
            && request.resource.data.deletedBy == request.auth.uid && request.resource.data.deletedAt == request.time)
          || (resource.data.status == 'discarded' && request.resource.data.status != 'discarded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'restoredAt', 'restoredBy', 'updatedAt', 'updatedBy'])
            && request.resource.data.restoredBy == request.auth.uid && request.resource.data.restoredAt == request.time));
        allow delete: if false;

        // One document per tap. A changed mark carries every version in `hist` (append-only; the top-level
        // fields always equal the newest version, whose uid is the caller). A fresh tap has no hist (2.4 shape).
        match /marks/{markId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId) && markOk()
            && (('hist' in request.resource.data) ? versionOk() : request.resource.data.get('deleted', false) == false);
          allow update: if (isMember(teamId) && markOk() && (
              (!('hist' in resource.data) && !('hist' in request.resource.data) && request.resource.data.get('deleted', false) == false)
              || (('hist' in request.resource.data) && appendedHist() && versionOk())))
            || (isAdmin(teamId) && purging(teamId));
          allow delete: if isAdmin(teamId) && existsAfter(purgePath(teamId, resource.data.runnerId));
        }

        // Who is at which checkpoint (2.4). A phone writes only its own doc; any member may delete it (it is not data).
        match /coaches/{uid} {
          allow read, delete: if isMember(teamId);
          allow create, update: if isMember(teamId)
            && request.auth.uid == uid
            && raceOpen(teamId, raceId)
            && request.resource.data.keys().hasOnly(['cp', 'name', 'ver', 'at'])
            && shortString(request.resource.data.cp, 0, 40)
            && shortString(request.resource.data.name, 0, 30)
            && shortString(request.resource.data.ver, 1, 20)
            && request.resource.data.at == request.time;
        }
      }

      // Each coach phone's app version and last-seen time (2.6, Settings > Team).
      match /devices/{uid} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ver', 'name', 'seen'])
          && shortString(request.resource.data.ver, 1, 20)
          && shortString(request.resource.data.name, 0, 30)
          && request.resource.data.seen == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Admin "Delete permanently" (privacy request): one record per purged runner, no name. Never changed.
      match /purges/{athleteId} {
        allow read: if isMember(teamId);
        allow create: if isAdmin(teamId)
          && request.resource.data.keys().hasOnly(['at', 'by'])
          && request.resource.data.at == request.time
          && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
